<UserControl x:Class="FFmpegUtils.Controls.GifTrimEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FFmpegUtils.Controls"
             xmlns:app="clr-namespace:FFmpegUtils"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             FontWeight="Normal" IsVisibleChanged="Editor_IsVisibleChanged" Unloaded="Editor_Unloaded">
    <UserControl.Resources>
        <Style x:Key="TransportBase" TargetType="primitives:ButtonBase">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ButtonBase">
                        <Border x:Name="TransportBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border x:Name="KeyboardBorder" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TransportBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="TransportBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TransportBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="app:MainWindow.ShowKeyboardFocusCues" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="KeyboardBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource TransportBase}" />
        <Style x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource TransportBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransportIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:ButtonBase}}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,6,0,0">
        <Grid x:Name="PreviewViewport" Height="180" Background="Black">
            <Image x:Name="PreviewImage" Source="{Binding Frame}" Stretch="Uniform" AutomationProperties.Name="选区原视频预览画面（无声）" />
            <TextBlock Text="选择 MP4 后即可预览" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasVideo}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Column="1" Text="{Binding PreviewTimeText}" FontSize="11" Margin="8,0,0,0" />
        </Grid>
        <ProgressBar Height="2" IsIndeterminate="{Binding IsBusy}" Margin="0,1">
            <ProgressBar.Style><Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></ProgressBar.Style>
        </ProgressBar>
        <local:RangeTimeline x:Name="Timeline" Duration="{Binding Duration}" Start="{Binding Start}" End="{Binding End}" Position="{Binding Position}"
                             Thumbnails="{Binding Thumbnails}" IsEnabled="{Binding CanEdit}"
                             RangeSelectionChanged="Timeline_RangeChanged" SeekRequested="Timeline_SeekRequested"
                             InteractionStarted="Timeline_InteractionStarted" InteractionCompleted="Timeline_InteractionCompleted" />
        <WrapPanel Margin="0,0,0,6">
            <Button x:Name="PlaySelectionButton" Style="{StaticResource TransportButton}" Click="Play_Click" IsEnabled="{Binding CanPlay}"
                    ToolTip="{Binding PlayText}" AutomationProperties.Name="{Binding PlayText}">
                <Grid Width="16" Height="16">
                    <Path x:Name="PlayPauseIcon"><Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource TransportIcon}">
                            <Setter Property="Data" Value="M4,2 L14,8 L4,14 Z" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Data" Value="M5,2 V14 M11,2 V14" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </Path.Style></Path>
                </Grid>
            </Button>
            <Button x:Name="RestartSelectionButton" Style="{StaticResource TransportButton}" Click="Restart_Click" IsEnabled="{Binding CanPlay}"
                    ToolTip="从选区起点重新播放" AutomationProperties.Name="从选区起点重新播放">
                <Grid Width="16" Height="16"><Path Data="M2,2 V14 M13,2 L5,8 L13,14 Z" Style="{StaticResource TransportIcon}" /></Grid>
            </Button>
            <ToggleButton x:Name="LoopSelectionButton" Style="{StaticResource TransportToggle}" IsChecked="{Binding Loop}" IsEnabled="{Binding CanEdit}"
                          ToolTip="{Binding LoopText}" AutomationProperties.Name="循环播放选区">
                <Grid Width="16" Height="16"><Path Data="M2,7 V5 Q2,3 4,3 H14 M11,0 L14,3 L11,6 M14,9 V11 Q14,13 12,13 H2 M5,10 L2,13 L5,16" Style="{StaticResource TransportIcon}" /></Grid>
            </ToggleButton>
            <Button x:Name="ResetSelectionButton" Style="{StaticResource TransportButton}" Click="Reset_Click" IsEnabled="{Binding CanEdit}"
                    ToolTip="恢复选中整段视频" AutomationProperties.Name="恢复选中整段视频">
                <Grid Width="16" Height="16"><Path Data="M1,2 V14 M15,2 V14 M6,5 L3,8 L6,11 M3,8 H13 M10,5 L13,8 L10,11" Style="{StaticResource TransportIcon}" /></Grid>
            </Button>
        </WrapPanel>
        <Grid IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="开始时间" Margin="0,0,0,2" />
                <TextBox x:Name="StartTimeBox" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputBox}" AutomationProperties.Name="GIF 选区开始时间" ToolTip="留空表示从开头开始；支持秒数、分:秒、时:分:秒。" />
            </StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="结束时间" Margin="0,0,0,2" />
                <TextBox x:Name="EndTimeBox" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource InputBox}" AutomationProperties.Name="GIF 选区结束时间" ToolTip="留空表示到视频结尾；不能超过视频总时长。" />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding SelectionText}" VerticalAlignment="Bottom" Margin="10,0,0,5" />
        </Grid>
        <TextBlock Text="{Binding RangeError}" Style="{DynamicResource MetadataMessage}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding PreviewError}" Style="{DynamicResource MetadataMessage}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
