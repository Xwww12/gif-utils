<Window x:Class="FFmpegUtils.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FFmpegUtils"
        xmlns:controls="clr-namespace:FFmpegUtils.Controls"
        mc:Ignorable="d"
        Title="GIF Utils"
        Icon="Assets/AppIcon.ico"
        Width="780" Height="540" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#E1E1E1" />
        <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#E5F1FB" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#CCE4F7" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#EBEBEB" />
        <SolidColorBrush x:Key="TextBrush" Color="#111111" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#555555" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C7C7C7" />
        <SolidColorBrush x:Key="StrongBorderBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E" />
        <SolidColorBrush x:Key="FocusBrush" Color="#005FB8" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#0078D7" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="ToolTipBrush" Color="#FFFFE1" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5C5C5" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6A6A6" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="EngineStrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="EngineErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EngineError}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EngineError}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="HelpFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="HelpBadge" TargetType="Control">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="3,-3,0,0" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <TextBlock Text="?" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"
                                   TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       TextWrapping="Wrap" MaxWidth="360" LineHeight="18" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <EventSetter Event="PreviewMouseWheel" Handler="ScrollableControl_PreviewMouseWheel" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Margin="2,1" Background="{DynamicResource ScrollThumbBrush}"
                                BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="10" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectBox" TargetType="ComboBox">
            <EventSetter Event="PreviewMouseWheel" Handler="ScrollableControl_PreviewMouseWheel" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ClassicComboBoxItem}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="5,0,2,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                                                    <Path Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Fill="{DynamicResource TextBrush}" Stretch="Fill" Data="M 0 0 L 4 4 L 8 0 Z" />
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" HorizontalOffset="0"
                                   AllowsTransparency="True" Focusable="False" StaysOpen="False" PopupAnimation="None">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalAlignment="Left" FlowDirection="LeftToRight" MaxHeight="200"
                                        Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource StrongBorderBrush}"
                                        BorderThickness="1" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicButtonBase" TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:MainWindow.ShowKeyboardFocusCues" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ClassicButtonBase}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ClassicButtonBase}" />

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:MainWindow.ShowKeyboardFocusCues" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetadataValue" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="MetadataSection" TargetType="Border" BasedOn="{StaticResource SectionCard}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <DataTemplate x:Key="MetadataFieldTemplate">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource MetadataValue}"
                         ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="MetadataMessage" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,0,2,4" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GIF Utils" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImageInfoStatusText" Text="{Binding ImageInfo.Status}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsSelected, ElementName=ImageInfoTab, Converter={StaticResource BooleanToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Grid Width="400" HorizontalAlignment="Left" Margin="0,4,0,0"
                          Visibility="{Binding IsSelected, ElementName=GifTab, Converter={StaticResource BooleanToVisibility}}"
                          ToolTip="{Binding GifDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GifStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding GifProgress, Mode=OneWay}" Maximum="100" Height="7"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding GifProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Width="400" HorizontalAlignment="Left" Margin="0,4,0,0"
                          Visibility="{Binding IsSelected, ElementName=SubtitleTab, Converter={StaticResource BooleanToVisibility}}"
                          ToolTip="{Binding SubtitleDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SubtitleStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding SubtitleProgress, Mode=OneWay}" Maximum="100" Height="7"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding SubtitleProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Width="400" HorizontalAlignment="Left" Margin="0,4,0,0"
                          Visibility="{Binding IsSelected, ElementName=XDownloadTab, Converter={StaticResource BooleanToVisibility}}"
                          ToolTip="{Binding XDownloadDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding XDownloadStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding XDownloadProgress, Mode=OneWay}" Maximum="100" Height="7"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding XDownloadProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSelected, ElementName=GifTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelGif_Click"
                                IsEnabled="{Binding IsGifRunning}" AutomationProperties.Name="取消 GIF 转换" />
                        <Button Content="开始转换" Style="{StaticResource PrimaryButton}" Click="StartGif_Click"
                                IsEnabled="{Binding IsGifReady}" AutomationProperties.Name="开始 MP4 转 GIF" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSelected, ElementName=SubtitleTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelSubtitle_Click"
                                IsEnabled="{Binding IsSubtitleRunning}" AutomationProperties.Name="取消字幕烧录" />
                        <Button Content="开始烧录" Style="{StaticResource PrimaryButton}" Click="StartSubtitle_Click"
                                IsEnabled="{Binding IsSubtitleReady}" AutomationProperties.Name="开始烧录字幕" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSelected, ElementName=XDownloadTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelXDownload_Click"
                                IsEnabled="{Binding IsXBusy}" AutomationProperties.Name="取消 X 链接解析或下载" />
                        <Button Content="开始下载" Style="{StaticResource PrimaryButton}" Click="StartXDownload_Click"
                                IsEnabled="{Binding IsXDownloadReady}" AutomationProperties.Name="开始下载所选 X 媒体" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="12,4,12,6">
            <TabItem x:Name="GifTab" Header="MP4 转 GIF">
                <ScrollViewer x:Name="GifScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource EngineStrip}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding EnginePath}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineVersion}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                        Content="选择 FFmpeg" Style="{StaticResource SecondaryButton}" Click="SelectFfmpeg_Click"
                                        AutomationProperties.Name="选择 FFmpeg 可执行文件" />
                                <TextBlock x:Name="GifEngineErrorText" Grid.Row="1" Grid.ColumnSpan="3"
                                           Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" AllowDrop="True" DragOver="File_DragOver" Drop="GifInput_Drop">
                            <StackPanel>
                                <TextBlock Text="输入与保存" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="MP4 文件" />
                                    <TextBlock Grid.Column="1" Text="{Binding GifMediaSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GifInputPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True"
                                             AutomationProperties.Name="所选 MP4 文件" />
                                    <Button Grid.Column="1" Content="选择文件" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Click="BrowseGifInput_Click" IsEnabled="{Binding CanChangeGifSource}" AutomationProperties.Name="选择 MP4 文件" />
                                </Grid>
                                <TextBlock Text="GIF 保存位置" Margin="0,4,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GifOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                             AutomationProperties.Name="GIF 保存位置" />
                                    <Button Grid.Column="1" Content="选择位置" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Click="BrowseGifOutput_Click" AutomationProperties.Name="选择 GIF 保存位置" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="压缩设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="压缩模式" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="选择一组预设参数。高清画质最好但体积较大；均衡适合大多数情况；小体积和极小会降低分辨率、帧率及颜色；指定目标大小会自动多轮压缩；自定义保留你填写的参数。"
                                                     AutomationProperties.Name="压缩模式说明"
                                                     AutomationProperties.HelpText="说明 GIF 压缩模式预设的区别" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding GifPresetNames}" SelectedItem="{Binding SelectedGifPreset}"
                                                  Style="{StaticResource SelectBox}" AutomationProperties.Name="GIF 压缩模式" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="目标上限（MB）" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="希望 GIF 不超过的文件大小，仅在“指定目标大小”模式下生效。GIF 大小无法提前精确预测，程序最多尝试 4 轮压缩；如果最低质量仍然超过目标，会保留结果并提示。"
                                                     AutomationProperties.Name="目标大小说明"
                                                     AutomationProperties.HelpText="说明 GIF 目标文件大小上限" />
                                        </StackPanel>
                                        <TextBox Text="{Binding GifTargetSizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 IsEnabled="{Binding IsTargetSizeMode}" AutomationProperties.Name="GIF 目标大小 MB" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,0,0,6">
                                    <StackPanel Margin="0,0,6,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="最大宽度" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="输出 GIF 的最大像素宽度。程序不会放大比它更小的源视频。宽度越小，像素总量越少，文件通常会明显变小；常用值为 360、480、720。"
                                                     AutomationProperties.Name="最大宽度说明"
                                                     AutomationProperties.HelpText="说明 GIF 最大像素宽度" />
                                        </StackPanel>
                                        <TextBox Text="{Binding GifMaxWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting"
                                                 AutomationProperties.Name="GIF 最大宽度" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="帧率 FPS" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="每秒显示多少张画面。数值越高越流畅，但帧数和文件体积也越大。多数 GIF 使用 10–15 FPS 已较流畅，动作较快时可用 20 FPS。"
                                                     AutomationProperties.Name="帧率说明"
                                                     AutomationProperties.HelpText="说明 GIF 每秒帧数" />
                                        </StackPanel>
                                        <TextBox Text="{Binding GifFrameRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting"
                                                 AutomationProperties.Name="GIF 帧率" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="颜色数量" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="GIF 调色板最多可使用 256 种颜色。颜色越多，渐变和照片越自然，但文件通常更大；128–256 适合普通视频，64–128 适合界面录屏或小体积输出。"
                                                     AutomationProperties.Name="颜色数量说明"
                                                     AutomationProperties.HelpText="说明 GIF 调色板颜色数量" />
                                        </StackPanel>
                                        <TextBox Text="{Binding GifColors, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting"
                                                 AutomationProperties.Name="GIF 颜色数量" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="颜色抖动" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="用像素纹理模拟调色板中没有的颜色。平滑适合照片和渐变，视觉最好；规整通常更利于压缩，适合录屏；无抖动体积可能更小，但容易出现明显色带。"
                                                     AutomationProperties.Name="颜色抖动说明"
                                                     AutomationProperties.HelpText="说明 GIF 颜色抖动方式" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding DitherOptions}" SelectedItem="{Binding SelectedDither}"
                                                  Style="{StaticResource SelectBox}" AutomationProperties.Name="GIF 抖动方式" />
                                    </StackPanel>
                                </UniformGrid>

                                <Expander x:Name="GifTrimExpander" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" IsExpanded="False" Expanded="GifTrimExpander_Expanded">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="截取时间（可选）" VerticalAlignment="Center" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="拖动左右外侧小手柄调整起止时间，靠近播放指针时自动吸附；缩略图与下方播放条只改变播放位置。左右键定位，Shift+左右键调起点，Ctrl+左右键调终点，每次 0.05 秒。播放只限选区，收起后暂停。开始或结束留空表示视频开头或结尾。"
                                                     AutomationProperties.Name="截取时间说明"
                                                     AutomationProperties.HelpText="说明 GIF 开始和结束截取时间" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <controls:GifTrimEditor x:Name="GifTrimPanel" DataContext="{Binding GifTrim}" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding GifError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="2,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SubtitleTab" Header="字幕烧录">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource EngineStrip}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding EnginePath}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineVersion}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                        Content="选择 FFmpeg" Style="{StaticResource SecondaryButton}" Click="SelectFfmpeg_Click"
                                        AutomationProperties.Name="选择 FFmpeg 可执行文件" />
                                <TextBlock x:Name="SubtitleEngineErrorText" Grid.Row="1" Grid.ColumnSpan="3"
                                           Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" AllowDrop="True" DragOver="File_DragOver" Drop="SubtitleVideo_Drop">
                            <StackPanel>
                                <TextBlock Text="视频与字幕" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="视频文件" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtitleMediaSummary}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SubtitleVideoPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="选择视频" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Click="BrowseSubtitleVideo_Click" AutomationProperties.Name="选择需要烧录字幕的视频" />
                                </Grid>
                                <TextBlock Text="字幕文件" Margin="0,4,0,2" />
                                <Grid AllowDrop="True" DragOver="File_DragOver" Drop="SubtitleFile_Drop">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SubtitleFilePath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="选择字幕" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            Click="BrowseSubtitleFile_Click" AutomationProperties.Name="选择字幕文件" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="输出设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.6*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SubtitleOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                            <Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                                    Click="BrowseSubtitleOutput_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="编码方式" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="自动会依次实际检测 NVIDIA NVENC、Intel QSV 和 AMD AMF，均不可用时回退到 CPU。手动指定 GPU 时，如编码器或显卡不可用会直接提示。GPU 通常更快，但同一质量数值与 CPU 的画质并非完全等价。"
                                                     AutomationProperties.Name="视频编码方式说明"
                                                     AutomationProperties.HelpText="说明 CPU 与 GPU 视频编码方式" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding SubtitleVideoEncoderOptions}"
                                                  SelectedItem="{Binding SelectedSubtitleVideoEncoder}"
                                                  ToolTip="{Binding SelectedSubtitleVideoEncoder}"
                                                  Style="{StaticResource SelectBox}"
                                                  AutomationProperties.Name="字幕烧录编码方式" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="字幕编码" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="决定如何读取字幕文件中的文字。自动会优先识别 UTF-8，无法识别时尝试 GB18030；如果烧录后中文乱码，可手动切换为 UTF-8 或 GB18030。"
                                                     AutomationProperties.Name="字幕编码说明"
                                                     AutomationProperties.HelpText="说明字幕文本编码" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding SubtitleEncodingOptions}" SelectedItem="{Binding SelectedSubtitleEncoding}"
                                                  Style="{StaticResource SelectBox}" AutomationProperties.Name="字幕文件编码" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="视频质量" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}"
                                                     ToolTip="范围 16–30，越低画质越高、文件越大。CPU 使用 CRF，GPU 会映射为对应编码器的质量参数；推荐 18–23，默认 20。"
                                                     AutomationProperties.Name="视频质量说明"
                                                     AutomationProperties.HelpText="说明字幕烧录视频质量数值" />
                                        </StackPanel>
                                        <TextBox Text="{Binding SubtitleCrf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting"
                                                 AutomationProperties.Name="字幕烧录视频质量" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SubtitleError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="2,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="XDownloadTab" Header="X 下载">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource EngineStrip}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding EnginePath}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           Margin="8,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineVersion}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                        Content="选择 FFmpeg" Style="{StaticResource SecondaryButton}" Click="SelectFfmpeg_Click"
                                        AutomationProperties.Name="选择 X 下载合并所用的 FFmpeg 可执行文件" />
                                <TextBlock x:Name="XEngineErrorText" Grid.Row="1" Grid.ColumnSpan="3"
                                           Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="X 帖子链接" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding XUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                             ToolTip="支持 x.com、twitter.com 及 t.co 的公开帖子链接"
                                             AutomationProperties.Name="X 帖子链接" />
                                    <Button Grid.Column="1" Content="粘贴" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                            MinWidth="58" Click="PasteXUrl_Click" AutomationProperties.Name="从剪贴板粘贴 X 链接" />
                                    <Button Grid.Column="2" Content="解析链接" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                                            Click="ParseXUrl_Click" IsEnabled="{Binding CanParseXUrl}"
                                            AutomationProperties.Name="解析 X 帖子媒体" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="112" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="媒体与画质" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding XMediaSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                   Margin="8,2,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="全选" IsChecked="{Binding SelectAllXMedia, Mode=TwoWay}"
                                              VerticalAlignment="Center" AutomationProperties.Name="选择全部 X 媒体" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <ListBox ItemsSource="{Binding XMediaItems}" Background="{DynamicResource ControlBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="解析到的 X 媒体列表">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="4,3" />
                                                <Setter Property="IsTabStop" Value="False" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" /><ColumnDefinition Width="285" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="选择此媒体" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding QualityOptions}"
                                                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                                              Style="{StaticResource SelectBox}" VerticalAlignment="Center"
                                                              AutomationProperties.Name="下载画质">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="粘贴公开帖子链接并解析后，可在这里选择一个或全部媒体。"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasXMedia}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" /><ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="保存目录" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding XOutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                                 AutomationProperties.Name="X 视频保存目录" />
                                        <Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                                Click="BrowseXOutputDirectory_Click" AutomationProperties.Name="选择 X 视频保存目录" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Style="{StaticResource FieldHeader}">
                                        <TextBlock Text="文件名前缀" Style="{StaticResource HelpFieldLabel}" />
                                        <Control Style="{StaticResource HelpBadge}"
                                                 ToolTip="留空时使用 X_用户名_帖子ID。下载多个媒体会自动添加序号；若文件已存在，会再添加不重复的后缀。"
                                                 AutomationProperties.Name="X 下载文件名前缀说明" />
                                    </StackPanel>
                                    <TextBox Text="{Binding XFilePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                             AutomationProperties.Name="X 下载文件名前缀" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="打开文件夹" Style="{StaticResource SecondaryButton}" Margin="8,17,0,0"
                                        VerticalAlignment="Top" Click="OpenXOutputDirectory_Click" IsEnabled="{Binding HasXDownloadResult}"
                                        AutomationProperties.Name="打开 X 视频保存文件夹" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding XResultSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="2,0,2,2"
                                   ToolTip="{Binding XResultSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding XResultSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding XWarning}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,2,2" />
                        <TextBlock Text="{Binding XError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="2,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ImageInfoTab" Header="图片信息">
                <ScrollViewer x:Name="ImageInfoScrollViewer" DataContext="{Binding ImageInfo}"
                              FontWeight="Normal"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AllowDrop="True" PreviewDragOver="ImageInfo_DragOver" Drop="ImageInfo_Drop">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource MetadataSection}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding InputPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True"
                                         ToolTip="选择或拖入一张本地图片" AutomationProperties.Name="所选图片路径" />
                                <Button Grid.Column="1" Content="选择图片" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                        Click="BrowseImageInfo_Click" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="选择图片并读取信息" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource MetadataMessage}" Foreground="{DynamicResource ErrorBrush}" />
                        <TextBlock Text="{Binding Details.Warning}" Style="{StaticResource MetadataMessage}" Foreground="{DynamicResource MutedTextBrush}" />
                        <Border x:Name="ImageDimensionsSection" Style="{StaticResource MetadataSection}">
                            <StackPanel>
                                <TextBlock Text="图片尺寸" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Details.Dimensions}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ImageShootingSection" Style="{StaticResource MetadataSection}">
                            <StackPanel>
                                <TextBlock Text="拍摄信息" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Details.Shooting}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ImageLocationSection" Style="{StaticResource MetadataSection}" Margin="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="地理位置" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="ResolveImageAddressButton" DockPanel.Dock="Right" Content="{Binding AddressActionText}"
                                            Style="{StaticResource SecondaryButton}" Click="ResolveImageAddress_Click" IsEnabled="{Binding CanResolve}"
                                            ToolTip="手动联网查询；发送经纬度，不上传图片。查询中可点击取消。"
                                            AutomationProperties.Name="解析图片 GPS 地址或取消查询" />
                                    <TextBlock Text="{Binding AddressStatus}" ToolTip="{Binding AddressStatusToolTip}" TextTrimming="CharacterEllipsis"
                                               FontSize="11" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Details.Location}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="城市/区县" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Region, Mode=OneWay}" Style="{StaticResource MetadataValue}"
                                             ToolTip="{Binding Region}" AutomationProperties.Name="城市与区县（地图匹配）" />
                                    <TextBlock Grid.Row="1" Text="附近地址" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NearbyAddress, Mode=OneWay}" Style="{StaticResource MetadataValue}"
                                             ToolTip="{Binding NearbyAddress}" AutomationProperties.Name="附近街道或地标（非精确拍摄地址）" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"
                                           ToolTip="{Binding AddressDetail}">
                                    地图：Photon · <Hyperlink Click="OpenMapAttribution_Click" Foreground="{DynamicResource FocusBrush}">© OpenStreetMap 贡献者</Hyperlink>
                                    · 附近地址不代表准确拍摄地点
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
